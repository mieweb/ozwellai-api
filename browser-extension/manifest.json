{
  "manifest_version": 3,
  "name": "ozwell",
  "version": "0.1.0",
  "description": "Chat with ozwell and let it read and control the current website, with an optional launcher on the sites you choose.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "16": "assets/ozwell-16.png",
    "32": "assets/ozwell-32.png",
    "48": "assets/ozwell-48.png",
    "128": "assets/ozwell-128.png"
  },
  "action": {
    "default_title": "ozwell",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/ozwell-16.png",
      "32": "assets/ozwell-32.png",
      "48": "assets/ozwell-48.png",
      "128": "assets/ozwell-128.png"
    }
  },
  "web_accessible_resources": [{
    "resources": ["assets/ozwell-48.png"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src https://api.ozwell.ai https://ozwellapi.os.mieweb.org http://localhost:* http://127.0.0.1:*;"
  }
}
