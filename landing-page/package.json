{
  "name": "ozwellai-embedtest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.js --dev",
    "start": "node server.js",
    "build:q": "esbuild scripts/q-entry.js --bundle --outfile=public/vendor/q-bundle.js --format=iife --global-name=QAgent --external:wavesurfer.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "build:browser-tools": "esbuild scripts/browser-tools-entry.js --bundle --format=esm --target=es2022 --outfile=public/browser-tools-bundle.js",
    "predev": "npm run build:browser-tools",
    "prestart": "npm run build:browser-tools",
    "pretest": "npm run build:browser-tools",
    "test:browser-tools": "npm run build:browser-tools && playwright test --config playwright.browser-tools.config.ts"
  },
  "dependencies": {
    "@fastify/swagger-ui": "^2.1.0",
    "@mieweb/page-controller": "git+https://github.com/mieweb/page-agent.git#6963ab7a183ce38cce3f1bfc29e5c3ff206a1973",
    "dotenv": "^17.2.3",
    "express": "^4.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}
